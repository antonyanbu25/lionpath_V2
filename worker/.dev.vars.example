# Copy to worker/.dev.vars (gitignored) for local wrangler dev / npm run dev:node.
# Required for pre-call prep and post-call analysis locally.
GEMINI_API_KEY=your-gemini-api-key-from-aistudio

# Required for Firestore scripts (backfill-embeddings, backfill-call-summaries, seed-firestore-users).
# Must match web/firebase-config.local.js projectId (typically se-singha-paathi).
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional — Apollo enrichment (Phase 2). Never commit real keys.
# APOLLO_API_KEY=your-apollo-api-key

# wrangler secret put APOLLO_API_KEY
