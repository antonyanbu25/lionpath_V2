# Copy to .dev.vars (gitignored) and fill in your keys.
# Required for pre-call + post-call (both use Gemini by default).
GEMINI_API_KEY = "AIza..."

# Firebase Auth — set to enable Google SSO locally (requires firebase-config.local.js in web/)
FIREBASE_PROJECT_ID = "se-singha-paathi"

# CORS for local web dev (wrangler pages dev on 8788)
ALLOWED_ORIGINS = "http://localhost:8788,http://127.0.0.1:8788"
ALLOWED_EMAIL_DOMAIN = "freshworks.com"

# Optional — only if LLM_PROVIDER = "anthropic"
# ANTHROPIC_API_KEY = "sk-ant-..."

# Vertex AI on GCP (Cloud Run) — omit GEMINI_API_KEY; uses service account ADC instead.
# GOOGLE_CLOUD_PROJECT = "se-singha-paathi"
# VERTEX_LOCATION = "us-central1"

# Optional — ZoomInfo person enrich fallback when LinkedIn/web search finds no experience data
# ZOOMINFO_API_KEY = "your_zoominfo_bearer_token"

# Optional — Zoom OAuth (phase 2)
# ZOOM_CLIENT_ID = "your_zoom_client_id"
# ZOOM_CLIENT_SECRET = "your_zoom_client_secret"
# ZOOM_REDIRECT_URI = "http://localhost:8787/api/zoom/callback"
