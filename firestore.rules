// SERVER READS BYPASS THESE RULES
// Worker GET /api/calls|accounts|deals uses firebase-admin (Node only).
// Scoping enforced in worker/src/data/scope.ts + worker/src/routes/domain-reads.ts:
//   SE      → own resources (ownerId == userId)
//   Manager → own + same teamId
//   Director/org leader → own + team + same orgId (isOrgLeader)
//   Admin   → all
// Browser client SDK access remains governed by rules below.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function authIndexDoc() {
      return get(/databases/$(database)/documents/authIndex/$(request.auth.uid)).data;
    }

    function currentUserId() {
      return authIndexDoc().userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(currentUserId())).data;
    }

    function claimsVersion() {
      return request.auth.token.claimsVersion;
    }

    function hasScopeClaims() {
      return claimsVersion() >= 1
        && request.auth.token.role is string
        && request.auth.token.teamId is string
        && request.auth.token.orgId is string;
    }

    function userRole() {
      return hasScopeClaims() ? request.auth.token.role : userDoc().role;
    }

    function userTeamId() {
      return hasScopeClaims() ? request.auth.token.teamId : userDoc().teamId;
    }

    function userOrgId() {
      return hasScopeClaims() ? request.auth.token.orgId : userDoc().orgId;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isManager() {
      return isSignedIn() && (userRole() == 'manager' || userRole() == 'admin');
    }

    function isOwner(ownerId) {
      return isSignedIn() && currentUserId() == ownerId;
    }

    function sameTeam(teamId) {
      return isSignedIn() && userTeamId() == teamId;
    }

    function sameOrg(orgId) {
      return isSignedIn() && userOrgId() != null && userOrgId() == orgId;
    }

    function isOrgLeader() {
      let orgData = get(/databases/$(database)/documents/orgs/$(userOrgId())).data;
      return isManager()
        && userOrgId() != null
        && (
          orgData.directorId == currentUserId()
          || (orgData.keys().hasAny(['seniorLeaderIds']) && currentUserId() in orgData.seniorLeaderIds)
        );
    }

    function isPm() {
      return isSignedIn() && (userRole() == 'pm' || userRole() == 'admin');
    }

    function canReadProductSignal(orgId) {
      return isPm() && sameOrg(orgId);
    }

    function canReadTeamResource(ownerId, teamId, orgId) {
      return isAdmin()
        || isOwner(ownerId)
        || (isManager() && sameTeam(teamId))
        || (isManager() && isOrgLeader() && sameOrg(orgId));
    }

    function canWriteOwnResource(ownerId) {
      return isSignedIn() && currentUserId() == ownerId;
    }

    // --- Auth index (Firebase uid → internal User.id) ---
    match /authIndex/{authUid} {
      allow read: if isSignedIn() && request.auth.uid == authUid;
      allow create, update: if isSignedIn()
        && request.auth.uid == authUid
        && request.resource.data.userId is string;
      allow delete: if isAdmin();
    }

    // --- Users (document id = internal User.id) ---
    match /users/{userId} {
      allow read: if isSignedIn() && (currentUserId() == userId || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.id == userId;
      allow update: if isSignedIn() && (currentUserId() == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Orgs ---
    match /orgs/{orgId} {
      allow read: if isSignedIn() && (sameOrg(orgId) || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // --- Teams ---
    match /teams/{teamId} {
      allow read: if isSignedIn() && (sameTeam(teamId) || isAdmin() || (isOrgLeader() && resource.data.orgId == userOrgId()));
      allow create, update, delete: if isAdmin();
    }

    function onAccountSeTeam(accountData) {
      return accountData.keys().hasAny(['seTeamUserIds'])
        && currentUserId() in accountData.seTeamUserIds;
    }

    function managerCanReadAccount(accountData) {
      return isManager()
        && (
          (accountData.keys().hasAny(['seTeamTeamIds']) && userTeamId() in accountData.seTeamTeamIds)
          || (isOrgLeader() && sameOrg(accountData.orgId))
        );
    }

    function canReadAccount(accountData) {
      return isAdmin()
        || onAccountSeTeam(accountData)
        || managerCanReadAccount(accountData);
    }

    function accountProtectedFields() {
      return ['metadata', 'primarySeUserId', 'programPhase', 'arrActual'];
    }

    function canMutateAccountProtectedFields(accountData) {
      return isAdmin()
        || accountData.primarySeUserId == currentUserId()
        || managerCanReadAccount(accountData)
        || (isOrgLeader() && sameOrg(accountData.orgId));
    }

    function accountUpdateAllowed(accountData) {
      let diff = request.resource.data.diff(accountData);
      let protectedChanged = diff.changedKeys().hasAny(accountProtectedFields());
      return canReadAccount(accountData)
        && (!protectedChanged || canMutateAccountProtectedFields(accountData));
    }

    // --- Accounts (shared across SEs on deal team) ---
    match /accounts/{accountId} {
      allow read: if isSignedIn() && canReadAccount(resource.data);
      allow create: if isSignedIn()
                    && request.resource.data.orgId == userOrgId()
                    && onAccountSeTeam(request.resource.data);
      allow update: if isSignedIn() && accountUpdateAllowed(resource.data);
      allow delete: if isAdmin();
    }

    function canReadContact(contactData) {
      return isAdmin()
        || (contactData.keys().hasAny(['seTeamUserIds']) && currentUserId() in contactData.seTeamUserIds)
        || (isManager() && contactData.keys().hasAny(['seTeamTeamIds']) && userTeamId() in contactData.seTeamTeamIds)
        || (isOrgLeader() && sameOrg(contactData.orgId));
    }

    // --- Contacts ---
    match /contacts/{contactId} {
      allow read: if isSignedIn() && canReadContact(resource.data);
      allow create: if isSignedIn()
                    && canReadContact(request.resource.data);
      allow update: if isSignedIn() && canReadContact(resource.data);
      allow delete: if isAdmin();

      match /events/{eventId} {
        allow read: if isSignedIn()
                    && canReadContact(
                      get(/databases/$(database)/documents/contacts/$(contactId)).data
                    );
        allow create: if isSignedIn()
                      && canReadContact(
                        get(/databases/$(database)/documents/contacts/$(contactId)).data
                      );
        allow update, delete: if false;
      }
    }

    // --- Deal↔Contact join (OpportunityContactRole mirror) ---
    match /dealContacts/{linkId} {
      allow read: if canReadTeamResource(
        resource.data.ownerId, resource.data.teamId, resource.data.orgId
      );
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId()
                    && request.resource.data.dealId is string
                    && request.resource.data.contactId is string
                    && request.resource.data.accountId is string;
      allow update: if canWriteOwnResource(resource.data.ownerId)
                    && (
                      !request.resource.data.keys().hasAny(['createdAt'])
                      || request.resource.data.createdAt == resource.data.createdAt
                    );
      allow delete: if canWriteOwnResource(resource.data.ownerId) || isAdmin();
    }

    // --- Deals (opportunities on account) ---
    match /deals/{dealId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    // --- Lifecycles ---
    match /lifecycles/{lifecycleId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();

      match /events/{eventId} {
        allow read: if canReadTeamResource(
          get(/databases/$(database)/documents/lifecycles/$(lifecycleId)).data.ownerId,
          get(/databases/$(database)/documents/lifecycles/$(lifecycleId)).data.teamId,
          get(/databases/$(database)/documents/lifecycles/$(lifecycleId)).data.orgId
        );
        allow create: if canWriteOwnResource(
          get(/databases/$(database)/documents/lifecycles/$(lifecycleId)).data.ownerId
        );
        allow update, delete: if false;
      }
    }

    // --- Artifacts ---
    match /prepBriefs/{docId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /postCalls/{docId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /callSummaries/{docId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /tasks/{docId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin() || canWriteOwnResource(resource.data.ownerId);
    }

    // --- QIP rubrics (org-wide reference) ---
    match /rubrics/{rubricId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /rubricThemes/{themeDocId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- ARR price book (org-wide reference) ---
    match /priceBooks/{rowId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /addonPriceBooks/{rowId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /assumptionsBooks/{rowId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- QIP scorecards (queryable per-call scoring) ---
    match /scorecards/{scorecardId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /scorecardLines/{lineId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /scoreOverrides/{overrideId} {
      allow read: if canReadTeamResource(
        get(/databases/$(database)/documents/scorecardLines/$(resource.data.scorecardLineId)).data.ownerId,
        get(/databases/$(database)/documents/scorecardLines/$(resource.data.scorecardLineId)).data.teamId,
        get(/databases/$(database)/documents/scorecardLines/$(resource.data.scorecardLineId)).data.orgId
      );
      allow create: if canWriteOwnResource(request.resource.data.userId)
                    && request.resource.data.userId == currentUserId()
                    && canWriteOwnResource(
                      get(/databases/$(database)/documents/scorecardLines/$(request.resource.data.scorecardLineId)).data.ownerId
                    );
      allow update, delete: if false;
    }

    // --- Pass 2 video facts (same RBAC as scorecards / parent PostCall) ---
    match /videoFacts/{factsId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /timelineSegments/{segmentId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      // Owner delete: re-running a call replaces its derived rows rather than layering.
      allow delete: if canWriteOwnResource(resource.data.ownerId) || isAdmin();
    }

    match /timelineMarkers/{markerId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if canWriteOwnResource(resource.data.ownerId) || isAdmin();
    }

    // --- Pass 7 commitments + MoM (never auto-send) ---
    match /followUps/{followUpId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /objections/{objectionId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /momDrafts/{momId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId()
                    // Never create a MoM already marked sent — send is a human update.
                    && request.resource.data.sentAt == null;
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /meddpiccDeltas/{deltaId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /technicalCommits/{tcId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /tcDeltas/{deltaId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      // Re-running a call replaces its deltas — the owner clears their own rows.
      allow delete: if canWriteOwnResource(resource.data.ownerId) || isAdmin();
    }

    match /dealSignals/{signalId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /dealSummaries/{summaryId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /accountSummaries/{summaryId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /arrLines/{lineId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /arrOverrides/{overrideId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.userId)
                    && request.resource.data.userId == currentUserId()
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update, delete: if false;
    }

    // --- Product signal (ADR-006) ---
    match /productGaps/{gapId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId)
                  || canReadProductSignal(resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId)
                    || canReadProductSignal(resource.data.orgId);
      allow delete: if isAdmin();
    }

    match /whatWorks/{rowId} {
      allow read: if canReadTeamResource(resource.data.ownerId, resource.data.teamId, resource.data.orgId)
                  || canReadProductSignal(resource.data.orgId);
      allow create: if canWriteOwnResource(request.resource.data.ownerId)
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.orgId == userOrgId();
      allow update: if canWriteOwnResource(resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /gapClusters/{clusterId} {
      allow read: if canReadProductSignal(resource.data.orgId);
      allow create, update: if canReadProductSignal(request.resource.data.orgId);
      allow delete: if isAdmin();
    }

    match /clusteringState/{orgKey} {
      allow read: if canReadProductSignal(resource.data.orgId);
      allow create, update: if canReadProductSignal(request.resource.data.orgId);
      allow delete: if isAdmin();
    }

    // --- Legacy collections (read-only during migration) ---
    match /preps/{doc} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.auth.token.email_verified == true;
      allow update, delete: if false;
    }

    match /postcalls/{doc} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.auth.token.email_verified == true;
      allow update, delete: if false;
    }
  }
}
