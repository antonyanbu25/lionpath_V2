FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache tini ffmpeg

COPY worker/package.json worker/package-lock.json* ./
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev

COPY worker/tsconfig.json ./
COPY worker/src ./src
COPY deploy/vps/entrypoint-worker.sh /entrypoint-worker.sh
RUN chmod +x /entrypoint-worker.sh

ENV NODE_ENV=production
ENV PORT=8787
ENV HISTORY_FILE_DIR=/data/history
ENV VIDEO_DATA_DIR=/data/video
ENV VIDEO_PASS_ENABLED=1

EXPOSE 8787

RUN mkdir -p /data/history /data/video && chmod 700 /data

HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/api/config').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--", "/entrypoint-worker.sh"]
CMD ["npx", "tsx", "src/node-server.ts"]
