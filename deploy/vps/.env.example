# Copy to .env on the VPS — never commit the real file.
# chmod 600 .env after creating it.

# Required — Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# LLM settings (defaults match worker/wrangler.toml)
LLM_PROVIDER=gemini
MODEL=gemini-3.1-flash-lite
# Optional premium overrides — unset = flash-lite for research/extract; synthesize stays on 3.6-flash via pass table.
# RESEARCH_MODEL=gemini-3.6-flash
# SYNTHESIZE_MODEL=gemini-3.6-flash
RESEARCH_THINKING_LEVEL=medium
EFFORT=medium
POSTCALL_LLM_PROVIDER=gemini
POSTCALL_MODEL=gemini-3.1-flash-lite
POSTCALL_EFFORT=low

# CORS — must include your public web origin
ALLOWED_ORIGINS=https://portal.benjaminsquare.com

# Restrict sign-in to this email domain (empty = any verified Google account)
ALLOWED_EMAIL_DOMAIN=freshworks.com

# Firebase project id — set to se-singha-paathi for Google SSO (leave empty for demo login)
FIREBASE_PROJECT_ID=se-singha-paathi

# Firestore Admin reads (worker GET /api/calls|accounts|deals on VPS / Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# File-based history (Docker volume — do not change unless you know what you're doing)
HISTORY_FILE_DIR=/data/history

# Pass 2 video (ffmpeg on VPS) — staging + keyframes under VIDEO_DATA_DIR
VIDEO_DATA_DIR=/data/video
VIDEO_PASS_ENABLED=1

# Optional — Anthropic fallback
# ANTHROPIC_API_KEY=sk-ant-...

# Internal cron auth — Cloud Scheduler / VPS cron hits /api/internal/batch/* and nightly rebuild.
# Generate: openssl rand -hex 32
# INTERNAL_CRON_SECRET=your-random-secret
#
# VPS cron examples (portalapi = worker URL; use lionpathapi if that is your DNS):
# */10 * * * * curl -sf -X POST -H "X-Cron-Secret: $INTERNAL_CRON_SECRET" https://lionpathapi.benjaminsquare.com/api/internal/batch/poll
# 0 * * * * curl -sf -X POST -H "X-Cron-Secret: $INTERNAL_CRON_SECRET" https://lionpathapi.benjaminsquare.com/api/internal/batch/fallback
# 0 2 * * * curl -sf -X POST -H "X-Cron-Secret: $INTERNAL_CRON_SECRET" "https://lionpathapi.benjaminsquare.com/api/internal/batch/enqueue?workload=embedding-backfill"
# 0 3 * * * curl -sf -X POST -H "X-Cron-Secret: $INTERNAL_CRON_SECRET" https://lionpathapi.benjaminsquare.com/api/internal/read-models/nightly-rebuild
#
# See docs/VPS_DEPLOY.md § 5b for full setup.
# Batch API uses GEMINI_API_KEY (AI Studio) even when interactive calls use Vertex on Cloud Run.

# --- Cost control (see docs/COST_CONTROL.md) ---
# Layer 3: per-user daily token budget (requires Firestore admin credentials above)
DAILY_TOKEN_BUDGET_ENABLED=1
# DAILY_TOKEN_BUDGET_PER_USER=8000000
# DAILY_TOKEN_BUDGET_RESERVE=120000
# Layer 4: Pass 7 summarise anomaly (p95 × 2)
SUMMARISE_ANOMALY_ENABLED=1
# SUMMARISE_ANOMALY_MULTIPLIER=2
# SUMMARISE_ANOMALY_BASELINE_DAYS=14
# COST_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Zoom Server-to-Server OAuth — required for share links on accounts that force
# recaptcha (Freshworks). Create the app at marketplace.zoom.us > Develop >
# Server-to-Server OAuth, with scopes:
#   cloud_recording:read:list_account_recordings:admin
#   cloud_recording:read:list_recording_files:admin
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# Optional — per-SE Zoom user OAuth (not wired to a UI yet)
# ZOOM_REDIRECT_URI=https://portalapi.benjaminsquare.com/api/zoom/callback

# Freshdesk — score dispute + product feedback tickets (required for Dispute / Feedback)
FRESHDESK_DOMAIN=janus-assist.freshdesk.com
FRESHDESK_API_KEY=your-freshdesk-api-key
