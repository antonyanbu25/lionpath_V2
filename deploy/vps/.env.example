# Copy to .env on the VPS — never commit the real file.
# chmod 600 .env after creating it.

# Required — Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# LLM settings (defaults match worker/wrangler.toml)
LLM_PROVIDER=gemini
MODEL=gemini-3.1-flash-lite
RESEARCH_MODEL=gemini-3.6-flash
SYNTHESIZE_MODEL=gemini-3.6-flash
RESEARCH_THINKING_LEVEL=medium
EFFORT=medium
POSTCALL_LLM_PROVIDER=gemini
POSTCALL_MODEL=gemini-3.1-flash-lite
POSTCALL_EFFORT=low

# CORS — must include your public web origin
ALLOWED_ORIGINS=https://portal.benjaminsquare.com

# Restrict sign-in to this email domain (empty = any verified Google account)
ALLOWED_EMAIL_DOMAIN=freshworks.com

# Firebase project id — set to se-singha-paathi for Google SSO (leave empty for demo login)
FIREBASE_PROJECT_ID=se-singha-paathi

# File-based history (Docker volume — do not change unless you know what you're doing)
HISTORY_FILE_DIR=/data/history

# Pass 2 video (ffmpeg on VPS) — staging + keyframes under VIDEO_DATA_DIR
VIDEO_DATA_DIR=/data/video
VIDEO_PASS_ENABLED=1

# Optional — Anthropic fallback
# ANTHROPIC_API_KEY=sk-ant-...

# Zoom Server-to-Server OAuth — required for share links on accounts that force
# recaptcha (Freshworks). Create the app at marketplace.zoom.us > Develop >
# Server-to-Server OAuth, with scopes:
#   cloud_recording:read:list_account_recordings:admin
#   cloud_recording:read:list_recording_files:admin
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# Optional — per-SE Zoom user OAuth (not wired to a UI yet)
# ZOOM_REDIRECT_URI=https://portalapi.benjaminsquare.com/api/zoom/callback
