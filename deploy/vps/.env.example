# Copy to .env on the VPS — never commit the real file.
# chmod 600 .env after creating it.

# Required — Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# LLM settings (defaults match worker/wrangler.toml)
LLM_PROVIDER=gemini
MODEL=gemini-3.1-flash-lite
EFFORT=medium
POSTCALL_LLM_PROVIDER=gemini
POSTCALL_MODEL=gemini-3.1-flash-lite
POSTCALL_EFFORT=low

# CORS — must include your public web origin
ALLOWED_ORIGINS=https://lionpath.benjaminsquare.com

# Restrict sign-in to this email domain (empty = any verified Google account)
ALLOWED_EMAIL_DOMAIN=freshworks.com

# Firebase project id — must match web/firebase-config.local.js when Google SSO is enabled.
# Leave empty for demo login (se@freshworks.com / se123). See docs/FIREBASE_SETUP.md.
FIREBASE_PROJECT_ID=

# File-based history (Docker volume — do not change unless you know what you're doing)
HISTORY_FILE_DIR=/data/history

# Optional — Anthropic fallback
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — Zoom OAuth (phase 2)
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_REDIRECT_URI=https://lionpathapi.benjaminsquare.com/api/zoom/callback
