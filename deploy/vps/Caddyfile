# Caddy reverse proxy — automatic HTTPS via Let's Encrypt.
# DNS must point lion.* and api.lion.* to this VPS before first start.

{
	email admin@benjaminsquare.com
}

lion.benjaminsquare.com {
	encode gzip zstd
	reverse_proxy web:8788
}

api.lion.benjaminsquare.com {
	encode gzip zstd
	reverse_proxy worker:8787
}

