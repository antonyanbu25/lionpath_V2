# Caddy reverse proxy — automatic HTTPS via Let's Encrypt.
# DNS must point lionpath.* and lionpathapi.* to this VPS (DNS only — not Cloudflare proxied).

{
	email admin@benjaminsquare.com
}

lionpath.benjaminsquare.com {
	encode gzip zstd
	reverse_proxy web:8788
}

lionpathapi.benjaminsquare.com {
	encode gzip zstd
	reverse_proxy worker:8787
}

