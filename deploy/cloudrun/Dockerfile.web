# Stage 1 — esbuild production bundle (web/dist/boot.js)
FROM node:22-alpine AS builder
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# Stage 2 — nginx static host (Cloud Run PORT=8080)
FROM nginx:1.27-alpine
COPY deploy/cloudrun/nginx-cloudrun.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /web /usr/share/nginx/html
EXPOSE 8080
